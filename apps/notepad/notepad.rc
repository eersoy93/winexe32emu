/* Notepad resources: the program icon (the first icon is the EXE icon), the
   keyboard shortcuts and the dialogs */

#include <windows.h>
#include "resource.h"

IDI_NOTEPAD ICON "notepad.ico"

IDA_NOTEPAD ACCELERATORS
BEGIN
    "N",       IDM_NEW,        VIRTKEY, CONTROL
    "O",       IDM_OPEN,       VIRTKEY, CONTROL
    "S",       IDM_SAVE,       VIRTKEY, CONTROL
    "S",       IDM_SAVE_AS,    VIRTKEY, CONTROL, SHIFT
    "F",       IDM_FIND,       VIRTKEY, CONTROL
    "H",       IDM_REPLACE,    VIRTKEY, CONTROL
    "G",       IDM_GOTO,       VIRTKEY, CONTROL
    "Z",       IDM_UNDO,       VIRTKEY, CONTROL
    VK_F3,     IDM_FIND_NEXT,  VIRTKEY
    VK_F5,     IDM_TIME_DATE,  VIRTKEY
    VK_BACK,   IDM_UNDO,       VIRTKEY, ALT
END

/* Encoding (and line breaks) of a file to open or save */
IDD_ENCODING DIALOG 0, 0, 232, 92
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Encoding"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT "", IDC_ENCODING_NOTE, 8, 6, 216, 18
    LTEXT "&Encoding:", -1, 8, 30, 52, 9
    COMBOBOX IDC_ENCODING, 62, 28, 162, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Line breaks:", IDC_EOL_LABEL, 8, 50, 52, 9
    COMBOBOX IDC_EOL, 62, 48, 162, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 118, 72, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 174, 72, 50, 14
END

IDD_GOTO DIALOG 0, 0, 180, 56
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Go To Line"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT "&Line number:", -1, 8, 10, 52, 9
    EDITTEXT IDC_LINE, 62, 8, 110, 12, ES_NUMBER | ES_AUTOHSCROLL
    DEFPUSHBUTTON "Go To", IDOK, 66, 34, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 122, 34, 50, 14
END

IDD_ABOUT DIALOG 0, 0, 220, 86
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About Notepad"
FONT 8, "MS Sans Serif"
BEGIN
    ICON IDI_NOTEPAD, -1, 10, 10, 21, 20
    LTEXT "Notepad", -1, 42, 10, 170, 9
    LTEXT "", IDC_ABOUT_TEXT, 42, 22, 170, 40
    DEFPUSHBUTTON "OK", IDOK, 162, 66, 50, 14
END
